          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "stream_count_above",
        "title": {
          "en": "Active streams !{{is|is not}} above",
          "nl": "Actieve streams !{{is|is niet}} boven"
        },
        "titleFormatted": {
          "en": "Active streams !{{is|is not}} above [[count]]",
          "nl": "Actieve streams !{{is|is niet}} boven [[count]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tautulli"
          },
          {
            "name": "count",
            "type": "number",
            "min": 0,
            "step": 1,
            "placeholder": {
              "en": "Number of streams",
              "nl": "Aantal streams"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Tautulli",
        "nl": "Tautulli"
      },
      "class": "sensor",
      "capabilities": [
        "measure_streams",
        "plex_active",
        "transcoding_streams",
        "plays_today",
        "plays_this_week"
      ],
      "capabilitiesOptions": {
        "plex_active": {
          "titleTrue": {
            "en": "Active",
            "nl": "Actief"
          },
          "titleFalse": {
            "en": "Idle",
            "nl": "Inactief"
          }
        }
      },
      "ui": {
        "components": [
          {
            "id": "sensor",
            "capabilities": [
              "measure_streams",
              "plex_active",
              "transcoding_streams",
              "plays_today",
              "plays_this_week"
            ]
          }
        ]
      },
      "images": {
        "small": "/drivers/tautulli/assets/images/small.png",
        "large": "/drivers/tautulli/assets/images/large.png"
      },
      "pair": [
        {
          "id": "connect"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "nl": "Verbinding"
          },
          "children": [
            {
              "id": "url",
              "type": "text",
              "label": {
                "en": "Host URL",
                "nl": "Host-URL"
              }
            },
            {
              "id": "apiKey",
              "type": "password",
              "label": {
                "en": "API Key",
                "nl": "API-sleutel"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Polling",
            "nl": "Polling"
          },
          "children": [
            {
              "id": "pollInterval",
              "type": "number",
              "label": {
                "en": "Poll interval (seconds)",
                "nl": "Poll-interval (seconden)"
              },
              "value": 15,
              "step": 1,
              "min": 5,
              "max": 300
            }
          ]
        }
      ],
      "id": "tautulli"
    }
  ],
  "widgets": {
    "tautulli_nowplaying": {
      "name": {
        "en": "Now Playing",
        "nl": "Nu aan het afspelen"
      },
      "height": 1,
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "capabilities": "measure_streams"
        }
      },
      "settings": [
        {
          "id": "showPoster",
          "type": "checkbox",
          "label": {
            "en": "Show poster",
            "nl": "Poster tonen"
          },
          "value": true
        },
        {
          "id": "showTitle",
          "type": "checkbox",
          "label": {
            "en": "Show widget title",
            "nl": "Widgettitel tonen"
          },
          "value": true
        },
        {
          "id": "showClient",
          "type": "checkbox",
          "label": {
            "en": "Show client (product & player)",
            "nl": "Client tonen (product & speler)"
          },
          "value": true
        },
        {
          "id": "showStream",
          "type": "checkbox",
          "label": {
            "en": "Show stream (quality & decision)",
            "nl": "Stream tonen (kwaliteit & beslissing)"
          },
          "value": true
        },
        {
          "id": "showMedia",
          "type": "checkbox",
          "label": {
            "en": "Show media (video, audio & subtitle)",
            "nl": "Media tonen (video, audio & ondertitel)"
          },
          "value": true
        },
        {
          "id": "showNetwork",
          "type": "checkbox",
          "label": {
            "en": "Show network (location & bandwidth)",
            "nl": "Netwerk tonen (locatie & bandbreedte)"
          },
          "value": false
        }
      ],
      "api": {
        "getNowPlaying": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "tautulli_nowplaying"
    },
    "tautulli_recent": {
      "name": {
        "en": "Recently Played",
        "nl": "Recent afgespeeld"
      },
      "height": 1,
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "capabilities": "measure_streams"
        }
      },
      "settings": [
        {
          "id": "showTitle",
          "type": "checkbox",
          "label": {
            "en": "Show title",
            "nl": "Titel tonen"
          },
          "value": true
        },
        {
          "id": "groupByDay",
          "type": "checkbox",
          "label": {
            "en": "Group by day",
            "nl": "Groeperen per dag"
          },
          "value": true
        },
        {
          "id": "count",
          "type": "number",
          "label": {
            "en": "Number of items",
            "nl": "Aantal items"
          },
          "value": 10,
          "min": 1,
          "max": 25,
          "step": 1
        }
      ],
      "api": {
        "getHistory": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "tautulli_recent"
    },
    "tautulli_topstats": {
      "name": {
        "en": "Top Stats",
        "nl": "Topstatistieken"
      },
      "height": 1,
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "capabilities": "measure_streams"
        }
      },
      "settings": [
        {
          "id": "showTitle",
          "type": "checkbox",
          "label": {
            "en": "Show widget title",
            "nl": "Widgettitel tonen"
          },
          "value": true
        },
        {
          "id": "timeRange",
          "type": "dropdown",
          "label": {
            "en": "Time range",
            "nl": "Tijdperiode"
          },
          "value": "30",
          "values": [
            {
              "id": "7",
              "label": {
                "en": "Last 7 days",
                "nl": "Laatste 7 dagen"
              }
            },
            {
              "id": "30",
              "label": {
                "en": "Last 30 days",
                "nl": "Laatste 30 dagen"
              }
            },
            {
              "id": "90",
              "label": {
                "en": "Last 90 days",
                "nl": "Laatste 90 dagen"
              }
            }
          ]
        },
        {
          "id": "count",
          "type": "number",
          "label": {
            "en": "Items per section",
            "nl": "Items per sectie"
          },
          "value": 5,
          "min": 3,
          "max": 10,
          "step": 1
        },
        {
          "id": "showPoster",
          "type": "checkbox",
          "label": {
            "en": "Show poster for #1",
            "nl": "Poster tonen voor #1"
          },
          "value": true
        },
        {
          "id": "showMovies",
          "type": "checkbox",
          "label": {
            "en": "Show most watched movies",
            "nl": "Meest bekeken films tonen"
          },
          "value": true
        },
        {
          "id": "showTv",
          "type": "checkbox",
          "label": {
            "en": "Show most watched TV shows",
            "nl": "Meest bekeken series tonen"
          },
          "value": true
        },
        {
          "id": "showMusic",
          "type": "checkbox",
          "label": {
            "en": "Show most played artists",
            "nl": "Meest gespeelde artiesten tonen"
          },
          "value": true
        },
        {
          "id": "showUsers",
          "type": "checkbox",
          "label": {
            "en": "Show most active users",
            "nl": "Meest actieve gebruikers tonen"
          },
          "value": true
        },
        {
          "id": "showPlatforms",
          "type": "checkbox",
          "label": {
            "en": "Show most active platforms",
            "nl": "Meest actieve platforms tonen"
          },
          "value": true
        }
      ],
      "api": {
        "getTopStats": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "tautulli_topstats"
    }
  },
  "capabilities": {
    "measure_streams": {
      "title": {
        "en": "Active Streams",
        "nl": "Actieve streams"
      },
      "type": "number",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "plays_this_week": {
      "title": {
        "en": "Plays This Week",
        "nl": "Kijksessies deze week"
      },
      "type": "number",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "plays_today": {
      "title": {
        "en": "Plays Today",
        "nl": "Kijksessies vandaag"
      },
      "type": "number",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "plex_active": {
      "title": {
        "en": "Plex Active",
        "nl": "Plex actief"
      },
      "type": "boolean",
      "uiComponent": "sensor",
      "getable": true,
      "setable": false,
      "insights": true,
      "insightsTitleTrue": {
        "en": "Plex became active",
        "nl": "Plex werd actief"
      },
      "insightsTitleFalse": {
        "en": "Plex became idle",
        "nl": "Plex werd inactief"
      }
    },
    "transcoding_streams": {
      "title": {
        "en": "Transcoding Streams",
        "nl": "Transcoderende streams"
      },
      "type": "number",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Transcoding streams",
        "nl": "Transcoderende streams"
      }
    }
  }
}