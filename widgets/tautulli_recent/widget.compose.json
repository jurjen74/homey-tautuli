{
  "name": {
    "en": "Recently Played",
    "nl": "Recent afgespeeld"
  },
  "height": 1,
  "devices": {
    "type": "app",
    "singular": true,
    "filter": {
      "capabilities": "measure_streams"
    }
  },
  "settings": [
    {
      "id": "showTitle",
      "type": "checkbox",
      "label": { "en": "Show title", "nl": "Titel tonen" },
      "value": true
    },
    {
      "id": "groupByDay",
      "type": "checkbox",
      "label": { "en": "Group by day", "nl": "Groeperen per dag" },
      "value": true
    },
    {
      "id": "count",
      "type": "number",
      "label": { "en": "Number of items", "nl": "Aantal items" },
      "value": 10,
      "min": 1,
      "max": 25,
      "step": 1
    }
  ],
  "api": {
    "getHistory": {
      "method": "GET",
      "path": "/"
    }
  }
}
