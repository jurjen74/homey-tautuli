{
  "name": {
    "en": "Tautulli",
    "nl": "Tautulli"
  },
  "class": "sensor",
  "capabilities": [
    "measure_streams",
    "plex_active",
    "transcoding_streams",
    "plays_today",
    "plays_this_week"
  ],
  "capabilitiesOptions": {
    "plex_active": {
      "titleTrue":  { "en": "Active", "nl": "Actief" },
      "titleFalse": { "en": "Idle",   "nl": "Inactief" }
    }
  },
  "ui": {
    "components": [
      {
        "id": "sensor",
        "capabilities": [
          "measure_streams",
          "plex_active",
          "transcoding_streams",
          "plays_today",
          "plays_this_week"
        ]
      }
    ]
  },
  "images": {
    "small": "/drivers/tautulli/assets/images/small.png",
    "large": "/drivers/tautulli/assets/images/large.png"
  },
  "pair": [
    {
      "id": "connect"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "nl": "Verbinding"
      },
      "children": [
        {
          "id": "url",
          "type": "text",
          "label": {
            "en": "Host URL",
            "nl": "Host-URL"
          }
        },
        {
          "id": "apiKey",
          "type": "password",
          "label": {
            "en": "API Key",
            "nl": "API-sleutel"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Polling",
        "nl": "Polling"
      },
      "children": [
        {
          "id": "pollInterval",
          "type": "number",
          "label": {
            "en": "Poll interval (seconds)",
            "nl": "Poll-interval (seconden)"
          },
          "value": 15,
          "step": 1,
          "min": 5,
          "max": 300
        }
      ]
    }
  ]
}
